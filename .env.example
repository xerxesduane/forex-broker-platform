# ---------------------------------------------------------------------------
# Aurion Markets demo platform — environment template
# Copy to .env.local for local development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Supabase project (local `supabase start` prints these, or copy from your
# Supabase dashboard for a hosted project). The anon key is safe for the
# browser; the service role key is server-only and must never be exposed
# to client code or committed to git.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-service-role-key"

# Public site URL, used for building absolute links in emails etc.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Integration adapters — this demo ships every adapter in SIMULATION mode.
# Real credentials are intentionally never read while INTEGRATIONS_MODE=simulation.
# ---------------------------------------------------------------------------
INTEGRATIONS_MODE="simulation"

# MT5 adapter (server-side only; real values are never used in this demo stage)
MT5_MANAGER_HOST=""
MT5_MANAGER_LOGIN=""
MT5_MANAGER_PASSWORD=""
MT5_DEMO_SERVER_NAME="AurionMarkets-Demo"
MT5_DEMO_GROUP="demo\\standard"

# KYC provider adapter (simulated vendor reference, not a real integration)
KYC_PROVIDER_API_KEY=""
KYC_PROVIDER_WEBHOOK_SECRET=""

# Payment provider adapter (simulated vendor reference, not a real integration)
PAYMENTS_PROVIDER_API_KEY=""
PAYMENTS_PROVIDER_WEBHOOK_SECRET=""

# Email adapter (simulated in dev/staging; logs to console/table instead of sending)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="demo@aurion-markets.example"

# SMS adapter (simulated in dev/staging; logs to console/table instead of sending)
SMS_PROVIDER_API_KEY=""

# Document storage adapter (simulated locally; points at a private Supabase
# Storage bucket in staging/production)
DOCUMENT_STORAGE_BUCKET="kyc-documents"

# Demo data reset guard — required to run the destructive reset script
ALLOW_DEMO_DATA_RESET="true"
